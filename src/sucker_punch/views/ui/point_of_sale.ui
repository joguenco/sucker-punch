QLabel#lbl_t0_value, QLabel#lbl_tiva_value, QLabel#lbl_iva_value, QLabel#lbl_discount_value, QLabel#lbl_ice_value {
    background: #e3f5e3; border: 1px solid #9ccc9c; padding: 2px 8px; }
QLabel#lbl_total { background: #e3f5e3; border: 1px solid #9ccc9c; border-radius: 4px;
                   color: black; font-weight: bold; padding: 2px 14px; }
QPushButton#push_save { background: #f4f6fb; color: #000080; border: 1px solid #000080;
                        border-radius: 4px; padding: 6px 14px; font-weight: bold; }
QPushButton#push_save:hover { background: #e6ff8c; }</string>
